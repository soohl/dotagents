# Copy to .env at the repository root. Run chmod 600 .env.
# Never commit credentials or paste resolved Compose output into an issue.
COMPOSE_FILE=config/compose.yaml
WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Optional remote access. Configure the dedicated Tailscale node and Pocket ID
# client first. Keep these values stable across restarts and private backups.
# COMPOSE_FILE=config/compose.yaml:config/compose.remote.yaml
# FUNNEL_HOSTNAME=your-node.your-tailnet.ts.net
# POCKET_ID_ENCRYPTION_KEY=
# OAUTH_CLIENT_ID=cook-studio
# OAUTH_CLIENT_SECRET=
# WEBUI_PASSWORD_LOGIN_ENABLED=false
# WEBUI_OAUTH_MERGE_EMAIL=false

# Optional search. Append :config/compose.search.yaml to COMPOSE_FILE.
# BRAVE_SEARCH_API_KEY=

# Optional browser. Append :config/compose.browser.yaml after search.
# BROWSER_API_KEY=generate-a-random-secret-of-at-least-32-characters
# BROWSER_USER_ID=the-existing-chat-account-id
