# Copy to the root .env. Run chmod 600 .env.
# Never commit credentials or publish resolved Compose output.
# Set runtime choices in config.yaml. This file contains private values only.

# Optional Image workspace uses a discovered Image API.
# Enable applications.images in config.yaml.

# Optional browser tunnel with a login ID, password, and security key.
# Configure the dedicated Tailscale node first.
# Enable applications.remote_browser in config.yaml.
# FUNNEL_HOSTNAME=your-node.your-tailnet.ts.net
# Set private Authelia secrets before enabling remote browser access.
# AUTHELIA_SESSION_SECRET=
# AUTHELIA_STORAGE_ENCRYPTION_KEY=
# AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=
# HARNESS_LOGIN_USERNAME=
# Keep the password hash in the private Authelia account volume.

# Optional: enables native web search in Harness Chat.
# BRAVE_SEARCH_API_KEY=

# Harness reads enabled local models and discovered Tailscale gateways. The application owns later model settings.
# Chat and Agent mount their own sessions/chat or sessions/agent directory.
# Each uses its workspace subdirectory for project files. Never mount the repository root.
# Optional Chat-only Things MCP. Set a private token when enabling the bridge.
DOTAGENTS_THINGS_TOKEN=
# Calendar bridge credential. Enable the integration separately in config.yaml.
# Startup generates this token if it is empty; it is not an Apple account password.
DOTAGENTS_CALENDAR_TOKEN=
