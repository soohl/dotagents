#!/usr/bin/env bash

set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$ROOT/backends/scripts/common.sh"

model_configs() {
    find "$ROOT/models" -mindepth 2 -maxdepth 2 \
        -type f -name model.conf -print | sort
}

CONFIG_VARIABLES=

clear_model_config() {
    for name in $CONFIG_VARIABLES; do
        unset "$name"
    done
    CONFIG_VARIABLES=
}

source_config() {
    config=$1
    names=$(awk '
        /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=/ {
            name = $0
            sub(/^[[:space:]]*/, "", name)
            sub(/=.*/, "", name)
            print name
        }
    ' "$config")
    CONFIG_VARIABLES="${CONFIG_VARIABLES}${CONFIG_VARIABLES:+ }$(
        printf '%s\n' "$names" | tr '\n' ' '
    )"
    set -a
    # Config files are tracked, repository-owned shell data files.
    # shellcheck disable=SC1090
    . "$config"
    set +a
}

load_model_config() {
    MODEL_DIR=$1
    clear_model_config
    source_config "$MODEL_DIR/model.conf"
    configured_backend=${BACKEND:-}
    backend_config="$ROOT/backends/config/$configured_backend.conf"
    [ -f "$backend_config" ] || {
        printf 'Backend config is missing: %s\n' "$backend_config" >&2
        exit 1
    }
    clear_model_config
    source_config "$backend_config"
    source_config "$MODEL_DIR/model.conf"

    for required in MODEL_ID MODEL_NAME BACKEND COMPAT_PROFILE TARGET_HF_REPO \
        VARIANTS DEFAULT_VARIANT; do
        [ -n "${!required:-}" ] || {
            printf 'Missing %s in %s/model.conf\n' "$required" "$MODEL_DIR" >&2
            exit 1
        }
    done
    for variant in $VARIANTS; do
        download_config "$variant" target >/dev/null
        download_config "$variant" speculative >/dev/null || true
        download_config "$variant" vision >/dev/null || true
    done

    MODEL_ROOT="$MODEL_DIR/${MODEL_STORAGE_DIR:-gguf}"
    # Backward-compatible name used by the existing GGUF adapters.
    GGUF_ROOT="$MODEL_ROOT"
    RUNTIME_ROOT=${LLM_RUNTIME_ROOT:-"$MODEL_DIR/.runtime"}
    BACKEND_ROOT="$ROOT/backends/$BACKEND"
    BACKEND_ADAPTER="$ROOT/backends/scripts/$BACKEND.sh"
}

load_compat_profile() {
    profile_values=$(
        python3 "$ROOT/compatibility/resolve.py" "$COMPAT_PROFILE" \
            --backend "$BACKEND" --format shell
    )
    eval "$profile_values"
    CONFIG_VARIABLES="$CONFIG_VARIABLES PI_COMPAT_JSON \
PI_THINKING_LEVEL_MAP_JSON BENCHMARK_REASONING_JSON"
}

resolve_model_dir() {
    requested=$1
    while IFS= read -r config; do
        dir=${config%/model.conf}
        load_model_config "$dir"
        if [ "$requested" = "$MODEL_ID" ]; then
            printf '%s\n' "$dir"
            return
        fi
    done < <(model_configs)
    printf 'Unknown model: %s\n' "$requested" >&2
    exit 2
}

resolve_variant() {
    requested=${1:-$DEFAULT_VARIANT}
    for variant in $VARIANTS; do
        if [ "$requested" = "$variant" ]; then
            printf '%s\n' "$variant"
            return
        fi
    done
    printf 'Unknown variant: %s (use %s)\n' "$requested" "$VARIANTS" >&2
    exit 2
}

variant_display() {
    result=
    for variant in $VARIANTS; do
        [ -z "$result" ] || result="$result, "
        result="$result$variant"
        [ "$variant" != "$DEFAULT_VARIANT" ] || result="$result (default)"
    done
    printf '%s\n' "$result"
}

list_models() {
    printf '%-24s %-10s %-24s %s\n' \
        MODEL BACKEND VARIANTS CONTEXT
    while IFS= read -r config; do
        load_model_config "${config%/model.conf}"
        context_key=$(printf '%s_CONTEXT' "$BACKEND" | tr '[:lower:]' '[:upper:]')
        result=${!context_key}
        printf '%-24s %-10s %-24s %s\n' \
            "$MODEL_ID" "$BACKEND" \
            "$(variant_display)" "$result"
    done < <(model_configs)
}

storage_stats() {
    python3 - "$1" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
size = 0
files = 0
if root.is_dir():
    for path in root.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        relative = path.relative_to(root)
        if ".cache" in relative.parts:
            continue
        if path.name == ".gitkeep" or path.name.startswith(".llm-verified-"):
            continue
        size += path.stat().st_size
        files += 1
print(size, files)
PY
}

human_size() {
    awk -v bytes="$1" '
        BEGIN {
            split("B KiB MiB GiB TiB", units, " ")
            value = bytes
            unit = 1
            while (value >= 1024 && unit < 5) {
                value /= 1024
                unit++
            }
            if (unit == 1) {
                printf "%.0f %s", value, units[unit]
            } else {
                printf "%.2f %s", value, units[unit]
            }
        }
    '
}

configured_artifact_ready() {
    local config
    local download_type
    local first
    local second
    local third
    local actual_size
    local expected_sha
    local expected_size
    local relative_path
    local file_path

    config=$(download_config "$DEFAULT_VARIANT" target) || return 1
    IFS='|' read -r download_type first second third <<<"$config"
    case "$download_type" in
        file)
            file_path="$MODEL_ROOT/$first"
            [ -f "$file_path" ] || return 1
            actual_size=$(wc -c <"$file_path" | tr -d '[:space:]')
            [ "$actual_size" = "$second" ]
            ;;
        snapshot)
            while read -r expected_sha expected_size relative_path; do
                file_path="$MODEL_ROOT/$first/$relative_path"
                [ -f "$file_path" ] || return 1
                actual_size=$(wc -c <"$file_path" | tr -d '[:space:]')
                [ "$actual_size" = "$expected_size" ] || return 1
            done <"$MODEL_DIR/$second"
            ;;
        *)
            return 1
            ;;
    esac
}

list_downloaded() {
    local requested=${1:-}
    local found=0
    local rows=0
    local total=0
    local configured_storage
    local seen
    local stats
    local bytes
    local files
    local role
    local storage

    require_command python3
    printf '%-24s %-10s %-8s %12s %7s %s\n' \
        MODEL BACKEND STORAGE SIZE FILES ROLE
    while IFS= read -r config; do
        load_model_config "${config%/model.conf}"
        if [ -n "$requested" ] && [ "$requested" != "$MODEL_ID" ]; then
            continue
        fi
        found=1
        configured_storage=${MODEL_STORAGE_DIR:-gguf}
        seen=
        for storage in "$configured_storage" gguf mlx; do
            case " $seen " in
                *" $storage "*) continue ;;
            esac
            seen="$seen $storage"
            stats=$(storage_stats "$MODEL_DIR/$storage")
            read -r bytes files <<<"$stats"
            [ "$bytes" -gt 0 ] || continue
            if [ "$storage" = "$configured_storage" ] &&
               configured_artifact_ready; then
                role=ready
            else
                role=unused
            fi
            printf '%-24s %-10s %-8s %12s %7s %s\n' \
                "$MODEL_ID" "$BACKEND" "$storage" \
                "$(human_size "$bytes")" "$files" "$role"
            total=$((total + bytes))
            rows=$((rows + 1))
        done
    done < <(model_configs)

    if [ -n "$requested" ] && [ "$found" -eq 0 ]; then
        printf 'Unknown model: %s\n' "$requested" >&2
        exit 2
    fi
    if [ "$rows" -eq 0 ]; then
        printf 'No downloaded model weights found.\n'
    else
        printf '\nTotal: %s\n' "$(human_size "$total")"
    fi
}

usage() {
    cat <<'HELP'
Local LLM runner

Usage:
  ./llm list
  ./llm downloaded [model]
  ./llm setup <model>
  ./llm download <model> <variant> [--speculative|--vision]
  ./llm serve <model> [variant] [--speculative] [--vision]
  ./llm benchmark speed <model> [variant] [--speculative|--compare] [--vision]
  ./llm benchmark agentic <model> [variant] [options]
  ./llm benchmark research <model> [variant] [options]
  ./llm benchmark <agentic|research> report
  ./llm benchmark <agentic|research> self-test

Models are discovered from models/*/model.conf.
HELP
    printf '\nAvailable now:\n'
    list_models
}

task_usage() {
    suite=$1
    case "$suite" in
        agentic) max_output=4096 ;;
        research) max_output=4096 ;;
    esac
    cat <<HELP
Usage:
  ./llm benchmark $suite <model> [variant] [options]

Reasoning: native-strong (fixed; resolved by compatibility profile)

Options:
  --task ID                 Run one task (repeatable; default: all)
  --context-window TOKENS   Default and maximum: 65536
  --max-output TOKENS       Default: up to $max_output (fits reserve)
  --reserve-tokens TOKENS   Default: 10% of context, rounded up (6554)
  --keep-recent-tokens N    Default: up to 4096 (fits reserve)
  --retries N               Default: 2
  --transport MODE          sse|websocket|auto
  --cache-retention MODE    short|long
  --timeout SECONDS         Per task; default: 7200
HELP
}

agentic_context_from_args() {
    result=65536
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --context-window)
                [ "$#" -ge 2 ] || {
                    printf 'Missing value for --context-window.\n' >&2
                    return 2
                }
                result=$2
                shift 2
                ;;
            --context-window=*)
                result=${1#*=}
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    printf '%s\n' "$result"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Required command not found: %s\n' "$1" >&2
        exit 1
    }
}

download_key() {
    printf '%s' "$1" |
        tr '[:lower:]-.' '[:upper:]__' |
        tr -c '[:alnum:]_' '_'
}

download_config() {
    variant=$1
    kind=$2
    key=$(download_key "$variant")
    case "$kind" in
        target) prefix="DOWNLOAD_${key}" ;;
        speculative)
            prefix="DOWNLOAD_${key}_SPECULATIVE"
            variant_file_name="${prefix}_FILE"
            variant_size_name="${prefix}_SIZE"
            variant_sha_name="${prefix}_SHA256"
            if [ -z "${!variant_file_name:-}" ] &&
               [ -z "${!variant_size_name:-}" ] &&
               [ -z "${!variant_sha_name:-}" ]; then
                prefix=DOWNLOAD_SPECULATIVE
            fi
            ;;
        vision)
            prefix="DOWNLOAD_${key}_VISION"
            variant_file_name="${prefix}_FILE"
            variant_size_name="${prefix}_SIZE"
            variant_sha_name="${prefix}_SHA256"
            if [ -z "${!variant_file_name:-}" ] &&
               [ -z "${!variant_size_name:-}" ] &&
               [ -z "${!variant_sha_name:-}" ]; then
                prefix=DOWNLOAD_VISION
            fi
            ;;
        *)
            printf 'Invalid download kind: %s\n' "$kind" >&2
            exit 2
            ;;
    esac

    file_name="${prefix}_FILE"
    size_name="${prefix}_SIZE"
    sha_name="${prefix}_SHA256"
    directory_name="${prefix}_DIR"
    manifest_name="${prefix}_MANIFEST"
    file=${!file_name:-}
    expected_size=${!size_name:-}
    expected_sha=${!sha_name:-}
    directory=${!directory_name:-}
    manifest=${!manifest_name:-}
    if [ -n "$directory" ] || [ -n "$manifest" ]; then
        if [ -n "$file" ] || [ -n "$expected_size" ] ||
           [ -n "$expected_sha" ]; then
            printf 'Conflicting file and snapshot config for variant %s in %s/model.conf\n' \
                "$variant" "$MODEL_DIR" >&2
            exit 1
        fi
        if [ -z "$directory" ] || [ -z "$manifest" ]; then
            printf 'Incomplete %s snapshot config for variant %s in %s/model.conf\n' \
                "$kind" "$variant" "$MODEL_DIR" >&2
            exit 1
        fi
        case "$directory" in
            */*|.|..|'')
                printf 'Invalid %s in %s/model.conf: %s\n' \
                    "$directory_name" "$MODEL_DIR" "$directory" >&2
                exit 1
                ;;
        esac
        manifest_path="$MODEL_DIR/$manifest"
        [ -f "$manifest_path" ] || {
            printf 'Snapshot manifest is missing: %s\n' "$manifest_path" >&2
            exit 1
        }
        if ! awk '
            NF != 3 { exit 1 }
            length($1) != 64 || $1 !~ /^[0-9a-fA-F]+$/ { exit 1 }
            $2 !~ /^[0-9]+$/ || $2 == 0 { exit 1 }
            $3 == "" || $3 ~ /^\// || $3 ~ /(^|\/)\.\.(\/|$)/ { exit 1 }
            END { if (NR == 0) exit 1 }
        ' "$manifest_path"; then
            printf 'Invalid snapshot manifest: %s\n' "$manifest_path" >&2
            exit 1
        fi
        printf 'snapshot|%s|%s\n' "$directory" "$manifest"
        return
    fi
    if [ -z "$file" ] && [ -z "$expected_size" ] && [ -z "$expected_sha" ]; then
        return 1
    fi
    if [ -z "$file" ] || [ -z "$expected_size" ] || [ -z "$expected_sha" ]; then
        printf 'Incomplete %s download config for variant %s in %s/model.conf\n' \
            "$kind" "$variant" "$MODEL_DIR" >&2
        exit 1
    fi
    case "$expected_size" in
        *[!0-9]*|'')
            printf 'Invalid %s in %s/model.conf: %s\n' \
                "$size_name" "$MODEL_DIR" "$expected_size" >&2
            exit 1
            ;;
    esac
    case "$expected_sha" in
        *[!0-9a-fA-F]*|'')
            printf 'Invalid %s in %s/model.conf: %s\n' \
                "$sha_name" "$MODEL_DIR" "$expected_sha" >&2
            exit 1
            ;;
    esac
    [ "${#expected_sha}" -eq 64 ] || {
        printf 'Invalid %s in %s/model.conf: expected 64 hex characters\n' \
            "$sha_name" "$MODEL_DIR" >&2
        exit 1
    }
    printf 'file|%s|%s|%s\n' "$file" "$expected_size" \
        "$(printf '%s' "$expected_sha" | tr '[:upper:]' '[:lower:]')"
}

verify_model_file() {
    local path=$1
    local expected_size=$2
    local expected_sha=$3
    local actual_size
    local actual_sha
    actual_size=$(wc -c <"$path" | tr -d '[:space:]')
    [ "$actual_size" = "$expected_size" ] || {
        printf 'Model file has the wrong size: %s\n' "$path" >&2
        printf 'Expected %s bytes, found %s.\n' \
            "$expected_size" "$actual_size" >&2
        exit 1
    }
    if command -v sha256sum >/dev/null 2>&1; then
        actual_sha=$(sha256sum "$path" | awk '{print $1}')
    elif command -v shasum >/dev/null 2>&1; then
        actual_sha=$(shasum -a 256 "$path" | awk '{print $1}')
    else
        printf 'Required command not found: sha256sum or shasum\n' >&2
        exit 1
    fi
    [ "$actual_sha" = "$expected_sha" ] || {
        printf 'Model file has the wrong SHA-256: %s\n' "$path" >&2
        printf 'Expected %s, found %s.\n' "$expected_sha" "$actual_sha" >&2
        exit 1
    }
}

verify_model_snapshot() {
    local snapshot=$1
    local manifest=$2
    local expected_sha
    local expected_size
    local relative_path
    local file_path
    while read -r expected_sha expected_size relative_path; do
        file_path="$snapshot/$relative_path"
        [ -f "$file_path" ] || {
            printf 'Snapshot file is missing: %s\n' "$file_path" >&2
            exit 1
        }
        verify_model_file "$file_path" "$expected_size" "$expected_sha"
    done <"$manifest"
}

download_model() {
    wanted=$1
    wanted_kind=${2:-target}
    mkdir -p "$MODEL_ROOT"
    config=$(download_config "$wanted" "$wanted_kind") || {
        printf 'No %s download configured for variant: %s\n' \
            "$wanted_kind" "$wanted" >&2
        exit 1
    }
    IFS='|' read -r download_type first second third <<<"$config"
    repo=$TARGET_HF_REPO
    if [ "$wanted_kind" = speculative ] &&
       [ -n "${SPECULATIVE_HF_REPO:-}" ]; then
        repo=$SPECULATIVE_HF_REPO
    elif [ "$wanted_kind" = vision ] &&
         [ -n "${VISION_HF_REPO:-}" ]; then
        repo=$VISION_HF_REPO
    fi
    revision=${TARGET_HF_REVISION:-}
    if [ "$wanted_kind" = speculative ] &&
       [ -n "${SPECULATIVE_HF_REVISION:-}" ]; then
        revision=$SPECULATIVE_HF_REVISION
    elif [ "$wanted_kind" = vision ] &&
         [ -n "${VISION_HF_REVISION:-}" ]; then
        revision=$VISION_HF_REVISION
    fi
    case "$download_type" in
        file)
            file=$first
            expected_size=$second
            expected_sha=$third
            path="$MODEL_ROOT/$file"
            if [ -e "$path" ]; then
                verify_model_file "$path" "$expected_size" "$expected_sha"
                printf 'Already downloaded; size and SHA-256 verified: %s\n' \
                    "$path"
                return
            fi

            require_command hf
            cache_dir="$RUNTIME_ROOT/huggingface"
            mkdir -p "$cache_dir"
            args=(
                download "$repo" "$file"
                --repo-type model
                --local-dir "$MODEL_ROOT"
            )
            [ -z "$revision" ] || args+=(--revision "$revision")
            [ -z "${HF_TOKEN:-}" ] || args+=(--token "$HF_TOKEN")
            printf 'Downloading %s file: %s/%s\n' \
                "$wanted_kind" "$repo" "$file"
            HF_HOME="$cache_dir" hf "${args[@]}"
            [ -f "$path" ] || {
                printf 'Download completed but the model file is missing: %s\n' \
                    "$path" >&2
                exit 1
            }
            verify_model_file "$path" "$expected_size" "$expected_sha"
            printf 'Downloaded; size and SHA-256 verified: %s\n' "$path"
            rm -rf "$MODEL_ROOT/.cache/huggingface"
            rmdir "$MODEL_ROOT/.cache" 2>/dev/null || true
            ;;
        snapshot)
            directory=$first
            manifest_path="$MODEL_DIR/$second"
            [ -n "$revision" ] || {
                printf 'Snapshot downloads require TARGET_HF_REVISION in %s/model.conf\n' \
                    "$MODEL_DIR" >&2
                exit 1
            }
            path="$MODEL_ROOT/$directory"
            marker="$path/.llm-verified-$revision"
            if [ -f "$marker" ]; then
                verify_model_snapshot "$path" "$manifest_path"
                printf 'Already downloaded; manifest verified: %s\n' "$path"
                return
            fi

            require_command hf
            cache_dir="$RUNTIME_ROOT/huggingface"
            mkdir -p "$cache_dir" "$path"
            args=(download "$repo")
            while read -r _snapshot_sha _snapshot_size snapshot_file; do
                args+=("$snapshot_file")
            done <"$manifest_path"
            args+=(
                --repo-type model
                --local-dir "$path"
                --revision "$revision"
            )
            [ -z "${HF_TOKEN:-}" ] || args+=(--token "$HF_TOKEN")
            printf 'Downloading %s snapshot: %s@%s\n' \
                "$wanted_kind" "$repo" "$revision"
            HF_HOME="$cache_dir" hf "${args[@]}"
            verify_model_snapshot "$path" "$manifest_path"
            touch "$marker"
            printf 'Downloaded; manifest verified: %s\n' "$path"
            rm -rf "$path/.cache/huggingface"
            rmdir "$path/.cache" 2>/dev/null || true
            ;;
        *)
            printf 'Unknown download type: %s\n' "$download_type" >&2
            exit 1
            ;;
    esac
}

run_backend() {
    action=$1
    variant=${2:-}
    speculative=${3:-}
    vision=${4:-}
    [ -x "$BACKEND_ADAPTER" ] || {
        printf 'Backend adapter is missing: %s\n' "$BACKEND_ADAPTER" >&2
        exit 1
    }
    export ROOT MODEL_DIR MODEL_ROOT GGUF_ROOT RUNTIME_ROOT BACKEND_ROOT
    exec "$BACKEND_ADAPTER" "$action" "$variant" "$speculative" "$vision"
}

parse_run_args() {
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    RUN_VARIANT=
    RUN_SPECULATIVE=
    RUN_VISION=
    while [ "$#" -gt 1 ]; do
        case "$2" in
            --speculative)
                [ -z "$RUN_SPECULATIVE" ] || {
                    printf 'Speculative mode was specified more than once.\n' >&2
                    exit 2
                }
                RUN_SPECULATIVE=on
                shift
                ;;
            --compare)
                [ -z "$RUN_SPECULATIVE" ] || {
                    printf 'Speculative mode was specified more than once.\n' >&2
                    exit 2
                }
                RUN_SPECULATIVE=compare
                shift
                ;;
            --vision)
                [ -z "$RUN_VISION" ] || {
                    printf 'Vision mode was specified more than once.\n' >&2
                    exit 2
                }
                RUN_VISION=on
                shift
                ;;
            --*)
                printf 'Unknown option: %s\n' "$2" >&2
                exit 2
                ;;
            *)
                [ -z "$RUN_VARIANT" ] || {
                    printf 'Unexpected argument: %s\n' "$2" >&2
                    exit 2
                }
                RUN_VARIANT=$2
                shift
                ;;
        esac
    done
}

select_model() {
    MODEL_DIR=$(resolve_model_dir "$1")
    load_model_config "$MODEL_DIR"
}

command=${1:-help}
case "$command" in
    help|-h|--help)
        usage
        ;;
    list)
        list_models
        ;;
    downloaded)
        [ "$#" -le 2 ] || { usage >&2; exit 2; }
        list_downloaded "${2:-}"
        ;;
    setup)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        select_model "$2"
        run_backend setup
        ;;
    download)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || {
            printf 'Download requires an explicit variant.\n\n' >&2
            usage >&2
            exit 2
        }
        download_kind=target
        if [ "$#" -eq 4 ]; then
            case "$4" in
                --speculative) download_kind=speculative ;;
                --vision) download_kind=vision ;;
                *)
                    printf 'Unknown download option: %s\n' "$4" >&2
                    exit 2
                    ;;
            esac
        fi
        select_model "$2"
        run_variant=$(resolve_variant "$3")
        download_model "$run_variant" "$download_kind"
        ;;
    serve)
        parse_run_args "${@:2}"
        select_model "$2"
        load_compat_profile
        case "${RUN_SPECULATIVE:-}" in
            ""|on) ;;
            compare)
                printf 'Speculative compare is benchmark-only.\n' >&2
                exit 2
                ;;
            *)
                printf 'Invalid speculative mode: %s\n' \
                    "$RUN_SPECULATIVE" >&2
                exit 2
                ;;
        esac
        if [ "${RUN_VISION:-}" = on ] && [ -z "${VISION_FILE:-}" ] &&
           [ "${MODEL_VISION_INTEGRATED:-0}" != 1 ]; then
            printf 'Vision is not configured for model: %s\n' "$MODEL_ID" >&2
            exit 2
        fi
        run_variant=$(resolve_variant "$RUN_VARIANT")
        run_backend serve "$run_variant" "$RUN_SPECULATIVE" "$RUN_VISION"
        ;;
    benchmark)
        benchmark_type=${2:-}
        case "$benchmark_type" in
            agentic|research)
                require_command python3
                case "${3:-}" in
                    report|self-test)
                        [ "$#" -eq 3 ] || {
                            printf 'Unexpected %s benchmark argument: %s\n' \
                                "$benchmark_type" "$4" >&2
                            exit 2
                        }
                        exec env PI_BENCH_SUITE="$benchmark_type" \
                            python3 "$ROOT/benchmarks/task_runner.py" "$3"
                        ;;
                    -h|--help)
                        task_usage "$benchmark_type"
                        exit
                        ;;
                esac
                [ "$#" -ge 3 ] || { usage >&2; exit 2; }
                select_model "$3"
                load_compat_profile
                [ "$BENCHMARK_REASONING_JSON" != "{}" ] || {
                    printf 'Compatibility profile %s has no benchmark reasoning mode.\n' \
                        "$COMPAT_PROFILE" >&2
                    exit 1
                }
                agentic_args=("${@:4}")
                agentic_variant=
                if [ "${#agentic_args[@]}" -gt 0 ] &&
                   [[ "${agentic_args[0]}" != --* ]]; then
                    agentic_variant=${agentic_args[0]}
                    agentic_args=("${agentic_args[@]:1}")
                fi
                agentic_variant=$(resolve_variant "$agentic_variant")
                API_MODEL_ID=${API_MODEL_ID:-$MODEL_ID}
                agentic_context=65536
                if [ "${#agentic_args[@]}" -gt 0 ]; then
                    agentic_context=$(
                        agentic_context_from_args "${agentic_args[@]}"
                    )
                fi
                require_context_limit "$agentic_context"
                PI_BENCH_SUITE="$benchmark_type" python3 "$ROOT/benchmarks/task_runner.py" \
                    run "benchmark-local-$BACKEND/$API_MODEL_ID" \
                    ${agentic_args[@]+"${agentic_args[@]}"} --validate-only
                server_helper="$ROOT/benchmarks/scripts/local_server.py"
                agentic_port=$(python3 "$server_helper" free-port)
                agentic_url="http://127.0.0.1:$agentic_port/v1"
                agentic_log=$(
                    mktemp "${TMPDIR:-/tmp}/llm-agentic-server.XXXXXX"
                )
                export ROOT MODEL_DIR MODEL_ROOT GGUF_ROOT RUNTIME_ROOT BACKEND_ROOT
                LLM_CTX="$agentic_context" \
                    LLM_HOST=127.0.0.1 LLM_PORT="$agentic_port" \
                    "$BACKEND_ADAPTER" serve "$agentic_variant" off \
                    >"$agentic_log" 2>&1 &
                agentic_server_pid=$!
                cleanup_agentic_server() {
                    kill "$agentic_server_pid" 2>/dev/null || true
                    wait "$agentic_server_pid" 2>/dev/null || true
                    rm -f "$agentic_log"
                }
                trap cleanup_agentic_server EXIT INT TERM
                if ! python3 "$server_helper" wait-ready \
                    --pid "$agentic_server_pid" \
                    --base-url "$agentic_url" \
                    --model "$API_MODEL_ID"
                then
                    printf '%s model server failed. Log: %s\n' \
                        "$benchmark_type" \
                        "$agentic_log" >&2
                    tail -40 "$agentic_log" >&2 || true
                    exit 1
                fi
                runner_args=(
                    run "benchmark-local-$BACKEND/$API_MODEL_ID"
                    --benchmark-model "$MODEL_ID"
                    --backend "$BACKEND"
                    --variant "$agentic_variant"
                    --base-url "$agentic_url"
                    --compat-profile "$COMPAT_PROFILE"
                    --reasoning-profile-json "$BENCHMARK_REASONING_JSON"
                )
                [ "${MODEL_REASONING:-0}" != 1 ] ||
                    runner_args+=(--reasoning)
                [ "$PI_COMPAT_JSON" = "{}" ] ||
                    runner_args+=(--compat-json "$PI_COMPAT_JSON")
                [ "$PI_THINKING_LEVEL_MAP_JSON" = "{}" ] ||
                    runner_args+=(
                        --thinking-level-map-json
                        "$PI_THINKING_LEVEL_MAP_JSON"
                    )
                if [ "${#agentic_args[@]}" -gt 0 ]; then
                    PI_BENCH_SUITE="$benchmark_type" \
                        python3 "$ROOT/benchmarks/task_runner.py" \
                        "${runner_args[@]}" "${agentic_args[@]}"
                else
                    PI_BENCH_SUITE="$benchmark_type" \
                        python3 "$ROOT/benchmarks/task_runner.py" \
                        "${runner_args[@]}"
                fi
                ;;
            speed)
                parse_run_args "${@:3}"
                select_model "$3"
                case "${RUN_SPECULATIVE:-}" in
                    ""|on|compare) ;;
                    *)
                        printf 'Invalid speculative mode: %s\n' \
                            "$RUN_SPECULATIVE" >&2
                        exit 2
                        ;;
                esac
                if [ "${RUN_VISION:-}" = on ] &&
                   [ -z "${VISION_FILE:-}" ] &&
                   [ "${MODEL_VISION_INTEGRATED:-0}" != 1 ]; then
                    printf 'Vision is not configured for model: %s\n' \
                        "$MODEL_ID" >&2
                    exit 2
                fi
                run_variant=$(resolve_variant "$RUN_VARIANT")
                run_backend benchmark "$run_variant" "$RUN_SPECULATIVE" \
                    "$RUN_VISION"
                ;;
            *)
                printf 'Unknown benchmark type: %s (use speed, agentic, or research).\n\n' \
                    "${benchmark_type:-<missing>}" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
